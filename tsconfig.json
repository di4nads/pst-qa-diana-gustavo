
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "@playwright/test"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "sprint1",
    "sprint2",
    "sprint3",
    "sprint4",
    "sprint5",
    "sprint5-holtesting",
    "sprint5-performance",
    "sprint5-with-bugs"
  ]
}
